{
  "name": "Teste e Qualidade de Software - IFCE Caninde",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && python -m playwright install --with-deps chromium",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-playwright.playwright"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "editor.rulers": [100],
        "files.encoding": "utf8"
      }
    }
  },

  "hostRequirements": {
    "cpus": 2
  },

  "remoteUser": "vscode"
}
